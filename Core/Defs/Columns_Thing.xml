<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <Stats.ColumnDef>
        <defName>Thing_Label</defName>
        <label>thing</label>
        <columnClass>Stats.Columns.ThingDef.LabelColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Thing_MarketValue</defName>
        <title>$$$</title>
        <stat>MarketValue</stat>
        <format>
            <pattern>0.00</pattern>
            <formatClass>Stats.NumberFormats.Money</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Thing_MaxHitPoints</defName>
        <title>HP</title>
        <stat>MaxHitPoints</stat>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Thing_Flammability</defName>
        <title><Damage_Heat/></title>
        <stat>Flammability</stat>
        <format>
            <formatClass>Stats.NumberFormats.Percent</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Thing_Mass</defName>
        <stat>Mass</stat>
        <format Class="Stats.NumberFormats.Inline">
            <pattern>0.000{kg}</pattern>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Thing_ContentSource</defName>
        <labelKey>Stat_Source_Label</labelKey>
        <columnClass>Stats.Columns.Def.ModContentPackColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Thing_TechLevel</defName>
        <label>tech level</label>
        <columnClass>Stats.Columns.ThingDef.TechLevelColumn`1</columnClass>
    </Stats.ColumnDef>

