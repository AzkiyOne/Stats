    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Thing_Beauty</defName>
        <stat>Beauty</stat>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Thing_ArmorRatingSharp</defName>
        <title><Armor/><Damage_Sharp/></title>
        <stat>ArmorRating_Sharp</stat>
        <format>
            <pattern>0.0</pattern>
            <formatClass>Stats.NumberFormats.Percent</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Thing_ArmorRatingBlunt</defName>
        <title><Armor/><Damage_Blunt/></title>
        <stat>ArmorRating_Blunt</stat>
        <format>
            <pattern>0.0</pattern>
            <formatClass>Stats.NumberFormats.Percent</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Thing_ArmorRatingHeat</defName>
        <title><Armor/><Damage_Heat/></title>
        <stat>ArmorRating_Heat</stat>
        <format>
            <pattern>0.0</pattern>
            <formatClass>Stats.NumberFormats.Percent</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Thing_EnergyShieldCapacity</defName>
        <title>Shield %</title>
        <stat>EnergyShieldEnergyMax</stat>
        <format>
            <formatClass>Stats.NumberFormats.Percent</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Thing_EnergyShieldRechargeRate</defName>
        <title>Shield %/s</title>
        <stat>EnergyShieldRechargeRate</stat>
        <format>
            <pattern>0\%/{LetterSecond}</pattern>
            <formatClass>Stats.NumberFormats.Percent</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

