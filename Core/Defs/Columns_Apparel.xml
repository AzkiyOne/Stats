<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Apparel_InsulationCold</defName>
        <labelShort><Temp_Cold/></labelShort>
        <stat>Insulation_Cold</stat>
        <format>
            <pattern>0.0</pattern>
            <formatClass>Stats.NumberFormats.TemperatureOffset</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Apparel_InsulationHeat</defName>
        <labelShort><Temp_Hot/></labelShort>
        <stat>Insulation_Heat</stat>
        <format>
            <pattern>0.0</pattern>
            <formatClass>Stats.NumberFormats.TemperatureOffset</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Apparel_OccupiedLayers</defName>
        <labelKey>Layer</labelKey>
        <descriptionKey>Stat_Thing_Apparel_Layer_Desc</descriptionKey>
        <columnClass>Stats.Columns.ApparelDef.LayersColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Apparel_CoveredBodyPartGroups</defName>
        <labelKey>Covers</labelKey>
        <descriptionKey>Stat_Thing_Apparel_Covers_Desc</descriptionKey>
        <columnClass>Stats.Columns.ApparelDef.BodyPartGroupsColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Apparel_CountsAsClothingForNudity</defName>
        <labelKey>Stat_Thing_Apparel_CountsAsClothingNudity_Name</labelKey>
        <descriptionKey>Stat_Thing_Apparel_CountsAsClothingNudity_Desc</descriptionKey>
        <labelShort><NudistPawn/></labelShort>
        <columnClass>Stats.Columns.ApparelDef.CountsAsClothingForNudityColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Apparel_EquipDelay</defName>
        <labelShort><Time/>Equip</labelShort>
        <stat>EquipDelay</stat>
        <format>
            <pattern>0 {LetterSecond}</pattern>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Apparel_MaxChargesCount</defName>
        <label>charges</label>
        <description>The maximum number of charges this object has.</description>
        <columnClass>Stats.Columns.ApparelDef.Reloadable.MaxChargesCountColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Apparel_IsDestroyedWhenAllChargesSpent</defName>
        <label>expendable</label>
        <description>This item will vanish when its last charge is used.</description>
        <columnClass>Stats.Columns.ApparelDef.Reloadable.IsDestroyedOnEmptyColumn`1</columnClass>
    </Stats.ColumnDef>

</Defs>
