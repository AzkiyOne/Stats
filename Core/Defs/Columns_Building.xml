    <Stats.ColumnDef>
        <defName>Building_Size</defName>
        <label>size</label>
        <columnClass>Stats.Columns.ThingDef.SizeColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Building_JoyGainFactor</defName>
        <labelShort><Recreation/>Power</labelShort>
        <stat>JoyGainFactor</stat>
        <format>
            <formatClass>Stats.NumberFormats.Percent</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Building_RecreationType</defName>
        <labelKey>StatsReport_JoyKind</labelKey>
        <descriptionKey>Stat_RecreationType_Desc</descriptionKey>
        <labelShort><Recreation/>Type</labelShort>
        <columnClass>Stats.Columns.BuildingDef.RecreationTypeColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Building_Comfort</defName>
        <stat>Comfort</stat>
        <format>
            <pattern>0.00</pattern>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Building_ImmunityGainSpeedFactor</defName>
        <labelShort>Immunity *%</labelShort>
        <stat>ImmunityGainSpeedFactor</stat>
        <format>
            <formatClass>Stats.NumberFormats.Percent</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Building_MedicalTendQualityOffset</defName>
        <labelShort>Tend +%</labelShort>
        <stat>MedicalTendQualityOffset</stat>
        <format>
            <formatClass>Stats.NumberFormats.Percent</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef Class="Stats.StatColumnDef">
        <defName>Building_SurgerySuccessChanceFactor</defName>
        <labelShort>Surgery *%</labelShort>
        <stat>SurgerySuccessChanceFactor</stat>
        <format>
            <formatClass>Stats.NumberFormats.Percent</formatClass>
        </format>
        <columnClass>Stats.Columns.BuildableDef.StatColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Building_PowerOutput</defName>
        <label>power output</label>
        <labelShort><Electricity/></labelShort>
        <columnClass>Stats.Columns.PowerTraderDef.PowerOutputColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Building_PowerOutputPerCell</defName>
        <label>power per cell</label>
        <labelShort><Electricity/><Per/>Cell</labelShort>
        <columnClass>Stats.Columns.PowerTraderDef.PowerOutputPerCellColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Building_PowerOutputPerFuel</defName>
        <label>power per fuel</label>
        <description>Measured in watts/unit.</description>
        <labelShort><Electricity/><Per/><Fuel/></labelShort>
        <columnClass>Stats.Columns.PowerTraderDef.PowerOutputPerFuelColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Building_PowerConsumption</defName>
        <label>power consumption</label>
        <labelShort><Electricity/><Decrease/></labelShort>
        <columnClass>Stats.Columns.PowerTraderDef.PowerConsumptionColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Building_FuelCapacity</defName>
        <label>fuel capacity</label>
        <labelShort><Fuel/></labelShort>
        <columnClass>Stats.Columns.RefuelableDef.FuelCapacityColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Building_FuelConsumptionRate</defName>
        <label>fuel consumption rate</label>
        <description>Measured in amount/day.</description>
        <labelShort><Fuel/><Decrease/><Per/>D</labelShort>
        <columnClass>Stats.Columns.RefuelableDef.FuelConsumptionRateColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Building_DaysPerRefuel</defName>
        <label>days per refuel</label>
        <labelShort>Days<Per/><Reload/></labelShort>
        <columnClass>Stats.Columns.RefuelableDef.DaysPerRefuelColumn`1</columnClass>
    </Stats.ColumnDef>

    <Stats.ColumnDef>
        <defName>Building_IsReinstallable</defName>
        <label>is reinstallable</label>
        <labelShort><IsBuildingReinstallable/></labelShort>
        <columnClass>Stats.Columns.ThingDef.IsMinifiableColumn`1</columnClass>
    </Stats.ColumnDef>

